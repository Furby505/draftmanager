# Model binaries are ignored by default; keep only the deployed DK EV policy tracked.
server/models/*.joblib
!server/models/model_dk_ev_policy.joblib

# Experiment model-metadata artifacts (the sibling .joblib are already ignored;
# committing orphaned _cols/_meta json without their binaries is just clutter).
server/models/_*.json
server/models/dk_ev_counterfactual_reranker_*.json
server/models/dk_ev_policy_calibrated_candidate_*.json

